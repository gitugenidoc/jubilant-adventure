# =====================================
# GENIDOC HOSPITAL PLATFORM
# Environment Configuration
# =====================================

# ==================== SERVER ====================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ==================== DATABASE ====================
DATABASE_URL="postgresql://genidoc:genidoc123@localhost:5432/genidoc_hospital"
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==================== JWT & SECURITY ====================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRY="7d"

# MFA
MFA_ISSUER="GeniDoc Hayat"
MFA_WINDOW=2

# ==================== ENCRYPTION ====================
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY="use-32-character-hex-string-here"
ENCRYPTION_IV="use-16-character-hex-string-here"

# ==================== HASHING ====================
BCRYPT_ROUNDS=12
ARGON2_TIME=2
ARGON2_MEMORY=65540
ARGON2_PARALLELISM=1

# ==================== EXTERNAL SERVICES ====================

# Email (for notifications, password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@genidoc.ma

# S3 / Object Storage (for documents)
STORAGE_TYPE=s3
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=genidoc-medical-docs
AWS_S3_ENDPOINT=https://s3.amazonaws.com

# ==================== FHIR & INTEROP ====================
FHIR_VERSION=R4
FHIR_BASE_URL=http://localhost:3000/api/fhir
HL7_PROCESSING=true
DICOM_PACS_ENDPOINT=http://localhost:8080/dcm4chee-arc

# ==================== SECURITY & COMPLIANCE ====================

# CORS
CORS_ORIGIN=http://localhost:5173,https://app.genidoc.ma
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5

# ==================== AUDIT & LOGGING ====================
AUDIT_LOG_RETENTION_DAYS=2555 # 7 years for medical records
SECURITY_LOG_RETENTION_DAYS=365

# Logs to file?
LOG_TO_FILE=true
LOG_DIR=./logs

# ==================== ADMIN SEED ====================
# These are used only for initial seed
ADMIN_EMAIL=admin@genidoc.ma
ADMIN_PASSWORD=Admin@123456
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=System

# ==================== FEATURE FLAGS ====================
FEATURE_MFA_REQUIRED=false
FEATURE_BREAK_GLASS=true
FEATURE_BREAK_GLASS_REQUIRES_JUSTIFICATION=true
FEATURE_FHIR_EXPORT=true
FEATURE_DMP_AUTO_PUBLISH=false
FEATURE_TELEMEDICINE=false

# ==================== ORGANIZATION SEED ====================
# Default organizations for demo
ORG_NAME_1="Hôpital Cheikh Khalifa"
ORG_CODE_1="hck"

ORG_NAME_2="Hôpital Universitaire Mohammed VI"
ORG_CODE_2="hum6"

ORG_NAME_3="Hôpital de Proximité"
ORG_CODE_3="proximity"

# ==================== DEBUG ====================
DEBUG=genidoc:*
VERBOSE_LOGGING=false
MOCK_PAYMENT_GATEWAY=true
